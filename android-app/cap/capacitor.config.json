{
  "appId": "com.wantsb.momcalendar",
  "appName": "맘캘린더",
  "webDir": "www",
  "backgroundColor": "#602090",
  "server": {
    "url": "https://momcalendar.com",
    "cleartext": false,
    "allowNavigation": [
      "momcalendar.com",
      "*.momcalendar.com",
      "kakao.com",
      "*.kakao.com",
      "nid.naver.com"
    ]
  },
  "android": {
    "appendUserAgent": "MomcalApp/android",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "native",
      "style": "DARK",
      "hidden": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
