{
  "appId": "com.wontsbe.momcalendar",
  "appName": "맘캘린더",
  "webDir": "www",
  "backgroundColor": "#FAF9FC",
  "server": {
    "url": "https://momcalendar.com",
    "cleartext": false,
    "allowNavigation": [
      "momcalendar.com",
      "*.momcalendar.com",
      "kauth.kakao.com",
      "accounts.kakao.com",
      "*.kakao.com",
      "hycaqsqeogjtbscmzrtm.supabase.co"
    ]
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false,
    "scrollEnabled": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#7B3FB5",
      "showSpinner": false
    }
  }
}
